# Supabase: Project URL (botão "Connect") e a chave pública — "Publishable key" (sb_publishable_...)
# em projetos novos, ou "anon public" nos antigos. Nunca use a secret / service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Modo demonstração: mostra os botões "Entrar como Gerente / Anfitrião / Cliente"
# e libera "Resetar demonstração". Em produção, deixe false (ou apague).
NEXT_PUBLIC_DEMO_MODE=false

# Credenciais das contas de demonstração — lidas SÓ no servidor (sem NEXT_PUBLIC_).
# Crie as contas como explica o README e use senhas exclusivas da demo.
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_HOST_EMAIL=
DEMO_HOST_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
